# Set to dynamodb only after creating both DynamoDB tables and configuring AWS access.
DATABASE_MODE=local
AWS_REGION=ap-south-1
DYNAMODB_STUDENTS_TABLE=VirtualClassroomStudents
DYNAMODB_LOGS_TABLE=VirtualClassroomAccessLogs
PORT=3000
# Do not paste AWS access keys into this file or share them in chat.
# For local development, configure credentials using: aws configure
